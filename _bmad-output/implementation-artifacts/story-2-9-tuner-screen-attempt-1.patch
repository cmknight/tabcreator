+      expect(s.inTune).toBe(true);
+    }
+    for (const c of [3.2, -3.2, 12]) {
+      const s = feed(INITIAL_TUNER_STATE, at(4, c), 0, 2000);
+      expect(s.inTune).toBe(false);
+      expect(s.reading!.cents).toBeCloseTo(c, 6);
+    }
+  });
